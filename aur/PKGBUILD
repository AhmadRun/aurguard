# Maintainer: AhmadRun <https://github.com/AhmadRun>
pkgname=aurguard
pkgver=0.1.0
pkgrel=1
pkgdesc="Self-updating malware scanner for AUR packages (yay/paru), with an Omarchy bar widget"
arch=('any')
url="https://github.com/AhmadRun/aurguard"
license=('MIT')
depends=('python' 'pacman')
optdepends=('libnotify: desktop notifications'
            'omarchy: AUR Guard bar widget')
install=aurguard.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4dc681ee97ce9b7e7aa41e93afaea60ef43090e36d9710f450c7848d9dd5f501')

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  local site
  site=$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
  install -dm755 "$pkgdir$site"
  cp -r aurguard "$pkgdir$site/"
  python -m compileall -q -d "$site" "$pkgdir$site/aurguard"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/aurguard" <<'LAUNCHER'
#!/usr/bin/python3
import sys
from aurguard.cli import main
sys.exit(main())
LAUNCHER
  install -Dm644 systemd/aurguard-* -t "$pkgdir/usr/lib/systemd/user/"
  install -dm755 "$pkgdir/usr/share/aurguard"
  cp -r omarchy-plugin "$pkgdir/usr/share/aurguard/"
  rm -f "$pkgdir/usr/share/aurguard/omarchy-plugin/install.sh"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
